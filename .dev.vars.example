# Plantilla de variables locales para `wrangler dev`.
#
# Copia este archivo a `.dev.vars` y reemplaza los placeholders por los
# valores reales. `.dev.vars` está ignorado por Git a propósito: NUNCA se
# versiona, y ningún valor real debe volver a este archivo de ejemplo.
#
# En Cloudflare, cuando esté autorizado, los OCHO secretos se cargan JUNTOS
# en una sola ejecución controlada. La PRIMERA vez, el Worker todavía no
# existe en remoto y se crea con:
#
#   npx wrangler deploy --secrets-file <archivo-temporal> --strict
#
# `wrangler deploy` es el único comando que crea el Worker inicial: subir una
# versión sobre un Worker inexistente no lo crea. Ese primer deployment es
# administrativo y NO abre acceso público: workers_dev: false, preview_urls:
# false y la ausencia de rutas hacen que no exista ninguna URL de ingreso.
#
# Una vez que el Worker YA existe, las versiones siguientes se suben sin
# desplegar con:
#
#   npx wrangler versions upload --secrets-file <archivo-temporal> --strict
#
# Cargar los secretos uno por uno con el subcomando `secret put` sería un
# error: ese comando crea una versión y la despliega de inmediato, así que
# ocho llamadas producirían ocho despliegues, siete de ellos con secretos
# incompletos.
#
# Este archivo (y su copia .dev.vars) NO se usa como archivo de carga: además
# de los ocho secretos contiene MIN_ADVANCE_MIN, que ya es una var pública
# declarada en wrangler.jsonc. Subirla también como secreto duplicaría ese
# binding. El archivo de carga se deriva aparte, con exactamente las ocho
# claves, fuera del repositorio y de forma temporal.
#
# BUSINESS_TIMEZONE también es una var pública declarada en wrangler.jsonc,
# pero no vive acá: no es una clave de este archivo ni de .dev.vars.

# ── Cliente OAuth 2.0 tipo "Aplicación de escritorio" ──────────────────
# Se crean en Google Cloud Console. Ver docs/OAUTH-SETUP.md.
GOOGLE_CLIENT_ID=reemplazar-con-el-client-id-de-escritorio
GOOGLE_CLIENT_SECRET=reemplazar-con-el-client-secret

# Lo genera `node scripts/oauth-setup.mjs` autorizando con la cuenta
# organizadora. No se escribe a mano.
GOOGLE_REFRESH_TOKEN=reemplazar-corriendo-scripts/oauth-setup.mjs

# ── Calendarios DEMO (propiedad de la cuenta organizadora) ─────────────
# Leonardo -> DEMO — Barbero 1 ; Vicente -> DEMO — Barbero 2.
# El id se copia desde Configuración del calendario > Integrar calendario.
BARBER_A_CALENDAR_ID=reemplazar-con-el-id-del-calendario-de-barbero-1
BARBER_B_CALENDAR_ID=reemplazar-con-el-id-del-calendario-de-barbero-2

# ── Invitados de cada evento ───────────────────────────────────────────
# El barbero correspondiente y la cuenta administradora reciben la
# invitación nativa de Google Calendar.
BARBER_A_EMAIL=reemplazar-con-el-correo-del-barbero-1
BARBER_B_EMAIL=reemplazar-con-el-correo-del-barbero-2
OWNER_EMAIL=reemplazar-con-el-correo-de-la-cuenta-administradora

# ── Opcionales ─────────────────────────────────────────────────────────
# Minutos mínimos de anticipación para reservar. Sin definir, es 0.
MIN_ADVANCE_MIN=0
